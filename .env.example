# ChessLab configuration. Copy to .env and uncomment what you want to change.
# Every setting is optional; the defaults are tuned for a local laptop.
# Never put secrets here that you would not want on disk. ChessLab itself
# needs no API keys or passwords.

# --- Server -------------------------------------------------------------------
# CHESSLAB_HOST=127.0.0.1          # keep 127.0.0.1 unless you know you need LAN access
# CHESSLAB_PORT=8000
# CHESSLAB_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
# CHESSLAB_LOG_JSON=false

# --- Data ---------------------------------------------------------------------
# Where the SQLite database, backups and logs live.
# Default on Windows: %LOCALAPPDATA%\ChessLab (outside the repository and OneDrive).
# CHESSLAB_DATA_DIR=D:\ChessLabData
# CHESSLAB_DATABASE_URL=sqlite:///D:/ChessLabData/chesslab.db

# --- Frontend -------------------------------------------------------------------
# Origins allowed to call the API from a browser (JSON list).
# CHESSLAB_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Serve the built frontend (frontend/dist) from the backend on the same port.
# CHESSLAB_SERVE_FRONTEND=true

# --- Engines ------------------------------------------------------------------
# Path to a Stockfish executable. If unset, ChessLab looks on PATH and in engines/.
# CHESSLAB_STOCKFISH_PATH=C:\Tools\stockfish\stockfish-windows-x86-64-avx2.exe
# CHESSLAB_CUSTOM_ENGINE_ENABLED=true
# CHESSLAB_ENGINE_IDLE_SHUTDOWN_S=600   # stop idle engine processes to free memory
# CHESSLAB_ENGINE_LOW_PRIORITY=false    # Windows below-normal priority for engines

# Hard ceilings that user settings can never exceed:
# CHESSLAB_MAX_ENGINE_THREADS=6
# CHESSLAB_MAX_ENGINE_HASH_MB=1024
# CHESSLAB_MAX_SEARCH_DEPTH=40
# CHESSLAB_MAX_MULTIPV=5
# CHESSLAB_MAX_ANALYSIS_SECONDS=60       # one-shot analysis / engine move
# CHESSLAB_MAX_LIVE_ANALYSIS_SECONDS=180 # "infinite" analysis auto-stops after this
# CHESSLAB_MAX_REVIEW_MOVETIME_MS=10000
# CHESSLAB_ANALYSIS_RATE_PER_MINUTE=120

# --- Uploads & imports ----------------------------------------------------------
# CHESSLAB_MAX_PGN_BYTES=5242880
# CHESSLAB_MAX_IMPORT_GAMES=5000

# --- Public chess APIs (free, no keys) ------------------------------------------
# Chess.com and Lichess ask clients to identify themselves. Adding contact info
# (e.g. an e-mail address or GitHub URL) lets them reach you instead of blocking.
# CHESSLAB_HTTP_CONTACT=you@example.com
# CHESSLAB_HTTP_TIMEOUT_S=30
# CHESSLAB_HTTP_MAX_RETRIES=3
